USE sigeh;

-- 1. SELECT simples: hospitais activos em Sofala.
SELECT id_hospital,nome,cidade,nivel FROM hospitais
WHERE provincia='Sofala' AND estado='ACTIVO' ORDER BY nome ASC;

-- 2. SELECT simples: camas livres.
SELECT id_cama,id_hospital,codigo,tipo,estado FROM camas
WHERE estado='LIVRE' ORDER BY id_hospital,codigo;

-- 3. SELECT simples: emergências de prioridade alta ou crítica.
SELECT codigo,data_hora,prioridade,estado FROM emergencias
WHERE prioridade IN ('ALTA','CRITICA') ORDER BY data_hora DESC;

-- 4. JOIN: cama, hospital e serviço.
SELECT h.nome AS hospital,c.codigo AS cama,c.tipo,c.estado,s.nome AS servico
FROM camas c JOIN hospitais h ON h.id_hospital=c.id_hospital
JOIN servicos s ON s.id_servico=c.id_servico ORDER BY h.nome,c.codigo;

-- 5. JOIN: stock de medicamentos com hospital e medicamento.
SELECT h.nome AS hospital,m.nome AS medicamento,sm.quantidade,sm.quantidade_reservada,
(sm.quantidade-sm.quantidade_reservada) AS quantidade_nao_reservada
FROM stock_medicamentos sm JOIN hospitais h ON h.id_hospital=sm.id_hospital
JOIN medicamentos m ON m.id_medicamento=sm.id_medicamento
ORDER BY quantidade_nao_reservada DESC;

-- 6. UPDATE: reservar cama 11. Resultado esperado: estado RESERVADA.
UPDATE camas SET estado='RESERVADA' WHERE id_cama=11 AND estado='LIVRE';

-- 7. UPDATE: alterar observação do pedido 1.
UPDATE pedidos_recepcao SET observacao='Actualização demonstrativa; confirmar por contacto directo.'
WHERE id_pedido=1;

-- 8. DELETE: apagar uma necessidade não referenciada por outras tabelas.
DELETE FROM necessidades WHERE id_necessidade=20;

-- Conferir os resultados das operações anteriores.
SELECT id_cama,estado FROM camas WHERE id_cama=11;
SELECT id_pedido,observacao FROM pedidos_recepcao WHERE id_pedido=1;
SELECT COUNT(*) AS necessidades_restantes FROM necessidades;

